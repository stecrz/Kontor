// mm_refresh.jxa -- loest in MoneyMoney "Alle Konten aktualisieren" aus.
//
// MoneyMoneys Skript-Schnittstelle kennt keinen Aktualisierungsbefehl; deshalb wird
// der Menuebefehl ueber die Bedienungshilfen (System Events) angeklickt. Dafuer muss
// macOS dem Programm (Terminal bzw. Kontor-Dienst) unter Systemeinstellungen >
// Datenschutz & Sicherheit > Bedienungshilfen den Zugriff erlauben.
// Es wird ausschliesslich ein Menuepunkt in MoneyMoney angeklickt, sonst nichts.
// Rueckgabe: "ok:<Menuepunkt>" oder "fehler:<Grund>".

function run() {
  const se = Application('System Events');
  let proc;
  try {
    proc = se.processes.byName('MoneyMoney');
    if (!proc.exists()) return 'fehler:MoneyMoney laeuft nicht';
  } catch (e) { return 'fehler:Keine Berechtigung fuer Bedienungshilfen (' + e.message + ')'; }
  try {
    const bar = proc.menuBars[0];
    const menus = bar.menuBarItems();
    for (const mbi of menus) {
      const title = String(mbi.name());
      if (!/konto|account/i.test(title)) continue;
      const items = mbi.menus[0].menuItems();
      let best = null;
      for (const it of items) {
        let n = '';
        try { n = String(it.name() || ''); } catch (e) { continue; }
        if (/aktualisier|refresh|update/i.test(n)) {
          if (/alle|all/i.test(n)) { best = it; break; }
          if (!best) best = it;
        }
      }
      if (best) {
        const n = String(best.name());
        best.click();
        return 'ok:' + n;
      }
    }
    return 'fehler:Menuepunkt "Aktualisieren" nicht gefunden';
  } catch (e) {
    return 'fehler:' + e.message;
  }
}
